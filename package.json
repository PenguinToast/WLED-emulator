{
  "name": "edc-wled-emulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "EDC_DEV_SERVER=1 tsx watch --clear-screen=false server.ts",
    "start": "tsx server.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:native": "node tools/audit-native-parity.mjs",
    "cpp:generate": "node tools/generate-upstream-fx.mjs",
    "cpp:run": "node tools/run-cpp-effect.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  }
}
