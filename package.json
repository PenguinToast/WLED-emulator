{
  "name": "edc-wled-emulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tsx server.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:native": "node tools/audit-native-parity.mjs",
    "cpp:generate": "node tools/generate-upstream-fx.mjs",
    "cpp:run": "node tools/run-cpp-effect.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "rollup": "npm:@rollup/wasm-node@^4.60.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.60.3"
  }
}
